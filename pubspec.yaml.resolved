name: scratch_deps
description: "A new Flutter project."
publish_to: 'none'
version: 0.1.0+1

environment:
  sdk: ^3.14.0

dependencies:
  connectivity_plus: ^7.3.2
  crypto: ^3.0.8
  flame: ^1.38.2
  flame_audio: ^2.12.2
  flutter:
    sdk: flutter
  flutter_local_notifications: ^23.0.3
  flutter_timezone: ^5.1.1
  google_mobile_ads: ^9.2.0
  in_app_purchase: ^3.3.1
  intl: ^0.20.3
  lucide_icons_flutter: ^4.0.3
  material_ui: ^1.1.0
  path_provider: ^2.1.6
  phosphor_flutter: ^2.1.0
  shared_preferences: ^2.5.6
  timezone: ^0.11.2
  url_launcher: ^6.3.3

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^6.0.0

flutter:
  uses-material-design: true
